# Copy this file to .env and fill in the values. Never commit .env.

# Token from @BotFather in Telegram
TELEGRAM_BOT_TOKEN=

# API key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Claude model that answers questions
LLM_MODEL=claude-haiku-5-5

# Where the bot sends customers when it has no answer (phone or @username)
MANAGER_CONTACT=
